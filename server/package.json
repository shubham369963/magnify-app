{
  "name": "server-nest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/main.js",
    "start:worker": "node --env-file=.env dist/worker-node/worker.js",
    "dev": "yarn docker:infra && node --env-file=.env --import tsx --watch src/main.ts",
    "dev:worker": "yarn docker:infra && node --env-file=.env --import tsx --watch src/worker-node/worker.ts",
    "dev:all": "yarn docker:up",
    "dev:all:local": "yarn docker:infra && concurrently --kill-others-on-fail --names server,worker \"node --env-file=.env --import tsx --watch src/main.ts\" \"node --env-file=.env --import tsx --watch src/worker-node/worker.ts\"",
    "docker:infra": "docker compose up -d --wait valkey qdrant",
    "docker:up": "docker compose up -d --build --wait api worker prometheus grafana",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api worker",
    "test": "yarn build && yarn test:unit",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:performance": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand src/document-service/pdf-chunking.performance.spec.js",
    "reindex": "node --env-file=.env dist/database/reindex.js",
    "migrate": "node --env-file=.env --import tsx src/database/migrate.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.12.2",
    "@as-integrations/express5": "^1.1.2",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.17",
    "@langchain/ollama": "^1.3.0",
    "@langchain/qdrant": "^1.0.3",
    "@nestjs/apollo": "^13",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/graphql": "^13",
    "@nestjs/platform-express": "^11.0.0",
    "@qdrant/js-client-rest": "^1.15.0",
    "bullmq": "^5.49.0",
    "graphql": "^16",
    "graphql-type-json": "^0.3.2",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.14.1",
    "concurrently": "^9.2.1",
    "jest": "^30.2.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "yarn@1.22.10"
}
