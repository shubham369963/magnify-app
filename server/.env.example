APP_PORT=8000

# Queue Redis backend.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6381

# Vector database.
QDRANT_URL=http://localhost:6335
QDRANT_API_KEY=

# Hosted model providers.
GOOGLE_API_KEY=
OLLAMA_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_CLOUD_CHAT_MODEL=gemma4:31b
OLLAMA_CLOUD_VISION_MODEL=gemma4:31b

# Gemini embedding request settings.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_BATCH_SIZE=100
GEMINI_EMBEDDING_BATCH_CONCURRENCY=1
GEMINI_EMBEDDING_MAX_ATTEMPTS=3
GEMINI_EMBEDDING_REQUEST_TIMEOUT_MS=60000
GEMINI_EMBEDDING_RETRY_DELAY_MS=250
GEMINI_EMBEDDING_MAX_RETRY_AFTER_MS=120000
# Proactive Gemini quota limiter shared by the API and worker through Redis; 0 disables it.
# Count each embedding input by default; use unit=request only when the provider counts each batch as one request.
GEMINI_EMBEDDING_RATE_LIMIT_PER_MINUTE=100
GEMINI_EMBEDDING_RATE_LIMIT_UNIT=input

# Maximum PDF upload size.
MAX_PDF_SIZE_BYTES=3145728

# Retrieval limits and score threshold.
RAG_MIN_RELEVANCE_SCORE=0.45
RAG_TREE_MAX_CANDIDATES_PER_CALL=20
RAG_TREE_MAX_EVIDENCE=8
RAG_TREE_MAX_CONTEXT_EXPANSIONS=4
RAG_TREE_SELECTOR_TOKEN_BUDGET=12000

# PDF indexing checkpoints and metrics listener.
PDF_INDEX_CHECKPOINT_DIR=uploads/.vector-index-checkpoints
METRICS_SERVICE_NAME=
WORKER_METRICS_PORT=9464

# Limits per worker process, shared by Vector and Index Tree image processing.
PDF_WORKER_CONCURRENCY=4
PDF_IMAGE_CONCURRENCY=4
PDF_RENDER_CONCURRENCY=2
# Skip captioning pages whose only images are small (icons, logos, company names) or repeated headers.
# Pixel thresholds, displayed size in PDF points (72 = 1 inch), and max pages per repeated image object. 0 disables.
PDF_IMAGE_MIN_WIDTH=150
PDF_IMAGE_MIN_HEIGHT=150
PDF_IMAGE_MIN_DISPLAY_POINTS=72
PDF_IMAGE_MAX_REPEAT_PAGES=3

# Grafana credentials.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
RENDER_EXTERNAL_HOSTNAME=

# Clerk backend token verification and webhook verification.
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=
CLERK_WEBHOOK_SIGNING_SECRET=

# Supabase backend values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# Direct Supabase PostgreSQL connection.
DATABASE_URL=