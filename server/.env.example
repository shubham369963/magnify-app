SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# Direct Supabase PostgreSQL connection, used only by `yarn migrate`.
# URL-encode special characters in the database password.
DATABASE_URL=postgresql://postgres:<url-encoded-password>@db.omscfbjtjbpznptopuyg.supabase.co:5432/postgres?sslmode=require